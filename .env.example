# GROVE Docker Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# API Keys
# ============================================
OPENAI_API_KEY=sk-proj-your-key-here

# Hugging Face Token (grove-model-centric-service에서 모델 다운로드에 필요)
# https://huggingface.co/settings/tokens 에서 발급
HF_TOKEN=hf_your-token-here

# ============================================
# Infrastructure
# ============================================

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=weavy
MILVUS_DIMENSION=1536

# ============================================
# Service Ports (Optional - defaults provided)
# ============================================
CACHE_SERVICE_PORT=8080
TASK_MIXTURE_PORT=8081
ZEBRA_SERVICE_PORT=8082
MODEL_CENTRIC_PORT=8083
WEAVY_PORT=8084
FRONTEND_PORT=80
